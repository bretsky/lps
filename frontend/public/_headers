# Cloudflare Pages response headers (copied into out/ by `next build`).
# The board's row lists are prerendered without a file extension, so label them JSON.
/api/board/*
  Content-Type: application/json; charset=utf-8

# Content-hashed bundles never change under the same name.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
